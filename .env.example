APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ----------------------------------------------------------------------------
# Seeded admin account
# ----------------------------------------------------------------------------
# DatabaseSeeder guarantees this account exists and is an admin on every
# deploy, so there is always a way to log in. The password is only re-applied
# while ADMIN_PASSWORD is set: clear it to keep a password you set by hand.
# The User model casts `password` to `hashed`, so the value is plain text here.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=waste_monitoring
DB_USERNAME=postgres
# Replace with the password set during your PostgreSQL 18 installation,
# or with the values Railway gives you (see "Railway deployment" below).
DB_PASSWORD=postgres

# ----------------------------------------------------------------------------
# Railway deployment (hosted PostgreSQL)
# ----------------------------------------------------------------------------
# When you deploy to Railway, add a PostgreSQL plugin. Railway automatically
# generates a "DATABASE_URL" variable. In the Railway dashboard -> Variables,
# add these two variables so Laravel uses the hosted database:
#
#     DB_CONNECTION = pgsql
#     DB_URL        = ${DATABASE_URL}
#
# (Railway resolves ${DATABASE_URL} to the full connection string like
#  postgresql://postgres:pw@xxxx.up.railway.app:5432/railway )
# The schema is created automatically on deploy by:  php artisan migrate --force
# ----------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------------------------------------------
# Machine learning (Teachable Machine / TensorFlow.js)
# ----------------------------------------------------------------------------
# Confidence (0-100) a live detection must reach before it is written to the
# classification log automatically.
WASTE_CONFIDENCE_THRESHOLD=70
# How often a frame is pulled from the camera, in milliseconds.
WASTE_FRAME_INTERVAL_MS=500
# Consecutive agreeing frames required before an automatic save.
WASTE_STABLE_FRAMES=3

# ----------------------------------------------------------------------------
# ESP32-CAM
# ----------------------------------------------------------------------------
# Point this at the camera's web server on your LAN, e.g. http://192.168.1.50:81
# The firmware in esp32cam/src/main.cpp serves /stream, /capture and /status.
# Flash it from VS Code with the PlatformIO extension; see esp32cam/README.md.
ESP32CAM_ENABLED=true
# The stock ESP32 CameraWebServer serves /stream on port 81 and /capture on
# port 80, so when you use that sketch you must set both. Our own firmware
# serves everything from one port, so leave this empty for it.
# ESP32CAM_URL=http://192.168.100.19:81
# ESP32CAM_CAPTURE_URL=http://192.168.100.19
ESP32CAM_URL=
ESP32CAM_CAPTURE_URL=
# Set only if you harden the sketch with a key.
ESP32CAM_API_KEY=
# Framesize constant from the ESP32 camera_pins.h used for still captures.
ESP32CAM_FRAMESIZE=VGA
# Seconds to wait for the camera before giving up.
ESP32CAM_CONNECT_TIMEOUT=3
ESP32CAM_READ_TIMEOUT=8
# How /api/esp32cam/stream gets its frames.
#   auto   - try the camera's own MJPEG port, fall back to polling /capture
#   native - only the camera's MJPEG port
#   poll   - always rebuild the stream by polling /capture
# The stock CameraWebServer serves one stream client and its handler only
# exits when the socket breaks, so a dropped connection can wedge that port
# until the board is power-cycled. "auto" recovers from that on its own.
ESP32CAM_STREAM_MODE=auto
# Pause between captured frames in poll mode. Lower = smoother, more load.
ESP32CAM_POLL_INTERVAL_MS=400
# Relays longer than this end so the browser reconnects to a fresh worker
# instead of one visitor holding a PHP worker. 0 disables the cap.
ESP32CAM_STREAM_MAX_SECONDS=900

# ----------------------------------------------------------------------------
# Device ingest (ESP32-CAM -> Laravel, push direction)
# ----------------------------------------------------------------------------
# The camera also pushes bin levels to this application on its own timer, so
# the dashboard stays live with no browser open on the classification page.
#
# Generate a long random string. It must match DEVICE_API_KEY in
# esp32cam/include/secrets.h, and every /api/device/* request must send it in
# the X-Device-Key header. Leaving it empty disables ingest entirely (503),
# which is the right default for a public deployment.
DEVICE_API_KEY=

# Base URL the camera posts to, as seen from the camera. Use your machine's LAN
# address, never localhost. 8000 = php artisan serve, 80 = XAMPP Apache.
ESP32CAM_INGEST_URL=http://192.168.1.50:8000

# Seconds between telemetry posts from the firmware.
ESP32CAM_TELEMETRY_INTERVAL=10

# At or above this percentage a bin is "Full" (collect immediately); between
# ESP32CAM_WARN_THRESHOLD and this it is "Near Full" (schedule a pickup).
ESP32CAM_FILL_THRESHOLD=85
ESP32CAM_WARN_THRESHOLD=75

# ----------------------------------------------------------------------------
# Concurrency (required for real-time updates)
# ----------------------------------------------------------------------------
# The MJPEG stream relay and the /api/live-stream Server-Sent Events feed are
# both long-lived requests, so each open tab occupies a server worker for up
# to LIVE_STREAM_TTL seconds. "php artisan serve" is single-threaded unless
# PHP_CLI_SERVER_WORKERS is set, and with one worker an open dashboard blocks
# every other request, including the camera's telemetry POSTs.
#
# Laravel only honours the worker count when serve runs with --no-reload.
# This is ignored on Windows, where PHP's built-in server cannot fork; serve
# through Apache/XAMPP there instead. It does apply on Linux (Railway).
PHP_CLI_SERVER_WORKERS=8

# Seconds a single /api/live-stream response stays open before the browser
# reconnects. Keep it low enough that PHP_CLI_SERVER_WORKERS covers your
# busiest page.
LIVE_STREAM_TTL=30
